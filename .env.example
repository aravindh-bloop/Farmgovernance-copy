# Cooperative AI Portal Environment Configuration
PORT=8000
HOST=0.0.0.0
ENV=development
APP_NAME="Multilingual Cooperative Governance & Legal Assistance Portal"
API_V1_STR="/api/v1"

# LLM Providers (Plug any: Sarvam, Groq, Ollama, OpenAI)
# Both keys are used together: Sarvam answers first, Groq (Qwen 3.8-27B) takes
# over automatically when Sarvam is unavailable, so the kiosk never goes silent.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
SARVAM_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_LLM_PROVIDER="sarvam" # options: sarvam, groq, ollama, local_rule_rag
SARVAM_LLM_MODEL="sarvam-105b-conversations"

# Language & Speech Translation (Bhashini Govt. pipeline first, then Sarvam Mayura, then Google gtx)
# Register at https://bhashini.gov.in and obtain the User ID and Inference API Key.
BHASHINI_USER_ID=""
BHASHINI_INFERENCE_API_KEY=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
DEFAULT_LANGUAGE="en" # Default to English / Hindi

# Vector Store & Cache
VECTOR_STORE_PATH="./database/vector_db"
OFFLINE_MODE=true
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
